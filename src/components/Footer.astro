---
import { defaultWhatsappUrl, nav, services, site } from '../data/site';
import Icon from './ui/Icon.astro';
---

<footer class="footer" id="contato">
	<div class="container">
		<div class="footer__top">
			<div class="footer__brand">
				<a class="footer__logo" href="#inicio" aria-label={`${site.legalName} — início`}>
					<span class="footer__mark">
						<Icon name="snowflake" size={21} />
					</span>
					<span>{site.brand}<em>{site.brandSuffix}</em></span>
				</a>
				<p class="footer__tagline">
					Venda, instalação e manutenção de ar-condicionado split com quem cuida do
					seu conforto o ano inteiro.
				</p>
				<div class="footer__social">
					<a href={site.instagram} aria-label="Instagram da Arketipo" target="_blank" rel="noopener noreferrer">
						<Icon name="instagram" size={18} />
					</a>
					<a href={site.facebook} aria-label="Facebook da Arketipo" target="_blank" rel="noopener noreferrer">
						<Icon name="facebook" size={18} />
					</a>
					<a href={defaultWhatsappUrl} aria-label="WhatsApp da Arketipo" target="_blank" rel="noopener noreferrer">
						<Icon name="whatsapp" size={18} />
					</a>
				</div>
			</div>

			<nav class="footer__col" aria-label="Serviços">
				<h2 class="footer__title">Serviços</h2>
				<ul>
					{services.map((service) => (
						<li><a href={service.href}>{service.eyebrow}</a></li>
					))}
					<li><a href="#duvidas">Dúvidas frequentes</a></li>
				</ul>
			</nav>

			<nav class="footer__col" aria-label="Navegação do rodapé">
				<h2 class="footer__title">Navegue</h2>
				<ul>
					{nav.map((item) => (
						<li><a href={item.href}>{item.label}</a></li>
					))}
				</ul>
			</nav>

			<div class="footer__col footer__contact">
				<h2 class="footer__title">Fale com a gente</h2>
				<ul>
					<li>
						<Icon name="phone" size={16} />
						<a href={site.phoneHref}>{site.phoneDisplay}</a>
					</li>
					<li>
						<Icon name="whatsapp" size={16} />
						<a href={defaultWhatsappUrl} target="_blank" rel="noopener noreferrer">
							{site.whatsappDisplay}
						</a>
					</li>
					<li>
						<Icon name="mail" size={16} />
						<a href={`mailto:${site.email}`}>{site.email}</a>
					</li>
					<li>
						<Icon name="map-pin" size={16} />
						<span>
							{site.address.street} — {site.address.district}
							<br />
							{site.address.city}, {site.address.state}
						</span>
					</li>
					<li>
						<Icon name="clock" size={16} />
						<span>{site.hours}</span>
					</li>
				</ul>
			</div>
		</div>

		<div class="footer__bottom">
			<p>
				© {new Date().getFullYear()} {site.legalName}. Todos os direitos reservados.
				<span class="footer__cnpj">CNPJ 00.000.000/0001-00</span>
			</p>
			<div class="footer__bottom-links">
				<span>Atendimento em {site.serviceArea}</span>
				<a href="#inicio">Voltar ao topo</a>
			</div>
		</div>
	</div>
</footer>

<style>
	.footer {
		padding-top: clamp(48px, 6vw, 72px);
		background: var(--primary-deep);
		color: #fff;
	}

	.footer__top {
		display: grid;
		grid-template-columns: minmax(0, 1.35fr) minmax(0, 0.75fr) minmax(0, 0.75fr) minmax(0, 1.1fr);
		gap: clamp(28px, 4vw, 52px);
		padding-bottom: 42px;
	}

	.footer__logo {
		display: inline-flex;
		align-items: center;
		gap: 10px;
		font-size: 1.22rem;
		font-weight: 700;
		letter-spacing: -0.04em;
		color: #fff;
		line-height: 1;
	}

	.footer__logo em {
		margin-left: 3px;
		font-style: normal;
		font-weight: 500;
		color: var(--accent);
	}

	.footer__mark {
		display: grid;
		place-items: center;
		width: 40px;
		height: 40px;
		border-radius: 12px;
		background: linear-gradient(145deg, #7652f5 0%, #4f2bd8 100%);
		color: #fff;
	}

	.footer__tagline {
		max-width: 320px;
		margin-top: 16px;
		font-size: 0.84rem;
		line-height: 1.6;
		color: rgba(255, 255, 255, 0.58);
	}

	.footer__social {
		display: flex;
		gap: 8px;
		margin-top: 20px;
	}

	.footer__social a {
		display: grid;
		place-items: center;
		width: 40px;
		height: 40px;
		border: 1px solid rgba(255, 255, 255, 0.14);
		border-radius: 11px;
		color: rgba(255, 255, 255, 0.78);
		transition:
			background-color 160ms var(--ease),
			border-color 160ms var(--ease),
			color 160ms var(--ease);
	}

	.footer__social a:hover {
		background: rgba(255, 255, 255, 0.08);
		border-color: rgba(255, 255, 255, 0.28);
		color: #fff;
	}

	.footer__title {
		font-size: 0.72rem;
		font-weight: 700;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: rgba(255, 255, 255, 0.42);
	}

	.footer__col ul {
		display: flex;
		flex-direction: column;
		gap: 9px;
		margin-top: 16px;
	}

	.footer__col a,
	.footer__col span {
		font-size: 0.83rem;
		line-height: 1.5;
		color: rgba(255, 255, 255, 0.68);
	}

	.footer__col a {
		transition: color 160ms var(--ease);
	}

	.footer__col a:hover {
		color: #fff;
	}

	.footer__contact li {
		display: flex;
		align-items: flex-start;
		gap: 9px;
	}

	.footer__contact li svg {
		flex-shrink: 0;
		margin-top: 3px;
		color: var(--accent);
	}

	.footer__bottom {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 18px;
		padding-block: 20px;
		border-top: 1px solid rgba(255, 255, 255, 0.1);
		font-size: 0.72rem;
		color: rgba(255, 255, 255, 0.42);
	}

	.footer__cnpj {
		margin-left: 10px;
	}

	.footer__bottom-links {
		display: flex;
		align-items: center;
		gap: 18px;
	}

	.footer__bottom-links a {
		color: rgba(255, 255, 255, 0.68);
		text-decoration: underline;
		text-underline-offset: 3px;
	}

	.footer__bottom-links a:hover {
		color: #fff;
	}

	@media (max-width: 1080px) {
		.footer__top {
			grid-template-columns: 1.4fr 1fr 1fr;
		}

		.footer__contact {
			grid-column: 1 / -1;
		}

		.footer__contact ul {
			flex-direction: row;
			flex-wrap: wrap;
			gap: 10px 28px;
		}
	}

	@media (max-width: 720px) {
		.footer__top {
			grid-template-columns: 1fr 1fr;
		}

		.footer__brand {
			grid-column: 1 / -1;
		}

		.footer__contact {
			grid-column: 1 / -1;
		}

		.footer__bottom {
			align-items: flex-start;
			flex-direction: column;
			gap: 8px;
		}

		.footer__cnpj {
			display: block;
			margin-left: 0;
		}
	}

	@media (max-width: 480px) {
		.footer__top {
			grid-template-columns: 1fr;
		}

		.footer__contact ul {
			flex-direction: column;
		}
	}
</style>
