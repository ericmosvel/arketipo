---
import { testimonials } from '../data/site';
import Icon from './ui/Icon.astro';
---

<section class="section testimonials" id="depoimentos">
	<div class="container">
		<div class="section-head" data-reveal>
			<div class="section-head__copy">
				<p class="eyebrow">Depoimentos</p>
				<h2 class="h2">Quem já sentiu a diferença.</h2>
			</div>
			<div class="testimonials__rating">
				<span class="stars" aria-hidden="true">
					<Icon name="star" size={15} />
					<Icon name="star" size={15} />
					<Icon name="star" size={15} />
					<Icon name="star" size={15} />
					<Icon name="star" size={15} />
				</span>
				<div>
					<strong>4,9 de 5</strong>
					<span>Avaliação média de clientes</span>
				</div>
			</div>
		</div>

		<div class="testimonials__grid">
			{testimonials.map((item, index) => (
				<figure
					class="testimonial"
					data-reveal
					data-reveal-delay={String(index + 1)}
				>
					<span class="testimonial__quote" aria-hidden="true">
						<Icon name="quote" size={28} />
					</span>

					<div class="testimonial__top">
						<span class="stars" aria-hidden="true">
							<Icon name="star" size={14} />
							<Icon name="star" size={14} />
							<Icon name="star" size={14} />
							<Icon name="star" size={14} />
							<Icon name="star" size={14} />
						</span>
						<span class="sr-only">5 de 5 estrelas</span>
						<span class="testimonial__verified">
							<Icon name="badge-check" size={14} />
							Cliente verificado
						</span>
					</div>

					<blockquote class="testimonial__body">
						<p>“{item.quote}”</p>
					</blockquote>

					<figcaption class="testimonial__author">
						<span class:list={['testimonial__avatar', `testimonial__avatar--${item.tone}`]}>
							{item.initials}
						</span>
						<div>
							<strong>{item.name}</strong>
							<span>{item.location}</span>
						</div>
					</figcaption>
				</figure>
			))}
		</div>
	</div>
</section>

<style>
	.testimonials__rating {
		display: flex;
		align-items: center;
		gap: 10px;
		flex-shrink: 0;
		padding: 10px 14px;
		border: 1px solid var(--border);
		border-radius: 14px;
		background: var(--surface);
		box-shadow: var(--shadow-sm);
	}

	.testimonials__rating .stars {
		display: inline-flex;
		gap: 2px;
		color: #d99400;
	}

	.testimonials__rating div {
		display: flex;
		flex-direction: column;
		line-height: 1.25;
	}

	.testimonials__rating strong {
		font-size: 0.82rem;
		color: var(--primary);
	}

	.testimonials__rating span:last-child {
		font-size: 0.68rem;
		color: var(--muted);
	}

	.testimonials__grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 20px;
	}

	.testimonial {
		position: relative;
		display: flex;
		flex-direction: column;
		margin: 0;
		padding: 24px;
		background: var(--surface);
		border: 1px solid var(--border);
		border-radius: 20px;
		box-shadow: var(--shadow-sm);
		overflow: hidden;
		transition:
			transform 220ms var(--ease),
			box-shadow 220ms var(--ease);
	}

	.testimonial:hover {
		transform: translateY(-4px);
		box-shadow: var(--shadow-md);
	}

	.testimonial__quote {
		position: absolute;
		top: 18px;
		right: 20px;
		color: var(--accent);
	}

	.testimonial__top {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 10px;
		padding-right: 36px;
	}

	.testimonial__top .stars {
		display: inline-flex;
		gap: 2px;
		color: #d99400;
	}

	.testimonial__verified {
		display: inline-flex;
		align-items: center;
		gap: 4px;
		font-size: 0.66rem;
		font-weight: 600;
		color: var(--success-ink);
		white-space: nowrap;
	}

	.testimonial__body {
		margin: 16px 0 24px;
	}

	.testimonial__body p {
		font-size: 0.94rem;
		line-height: 1.6;
		color: var(--text);
	}

	.testimonial__author {
		display: flex;
		align-items: center;
		gap: 10px;
		margin-top: auto;
		padding-top: 18px;
		border-top: 1px solid var(--border);
	}

	.testimonial__avatar {
		display: grid;
		place-items: center;
		width: 42px;
		height: 42px;
		border-radius: 50%;
		font-size: 0.68rem;
		font-weight: 700;
		color: #fff;
	}

	.testimonial__avatar--violet {
		background: linear-gradient(135deg, #7652f5, #4f2bd8);
	}

	.testimonial__avatar--blue {
		background: linear-gradient(135deg, #5e8bd8, #2f4f9e);
	}

	.testimonial__avatar--pink {
		background: linear-gradient(135deg, #d47bb8, #8e3f83);
	}

	.testimonial__author div {
		display: flex;
		flex-direction: column;
		line-height: 1.3;
	}

	.testimonial__author strong {
		font-size: 0.84rem;
		color: var(--primary);
	}

	.testimonial__author span:last-child {
		font-size: 0.72rem;
		color: var(--muted);
	}

	@media (max-width: 980px) {
		.testimonials__grid {
			grid-template-columns: 1fr;
			max-width: 620px;
		}
	}

	@media (max-width: 620px) {
		.testimonials__rating {
			align-self: flex-start;
		}
	}
</style>
