---
import { benefits } from '../data/site';
import Icon from './ui/Icon.astro';
---

<section class="benefits" aria-label="Diferenciais da Arketipo">
	<div class="container">
		<ul class="benefits__grid">
			{benefits.map((item, index) => (
				<li class="benefit" data-reveal data-reveal-delay={String(index + 1)}>
					<span class="benefit__icon">
						<Icon name={item.icon} size={21} />
					</span>
					<div>
						<h2 class="benefit__title">{item.title}</h2>
						<p class="benefit__description">{item.description}</p>
					</div>
				</li>
			))}
		</ul>
	</div>
</section>

<style>
	.benefits {
		background: var(--surface);
		border-bottom: 1px solid var(--border);
	}

	.benefits__grid {
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
	}

	.benefit {
		display: flex;
		align-items: flex-start;
		gap: 13px;
		padding: 30px 24px;
		border-right: 1px solid var(--border);
	}

	.benefit:first-child {
		padding-left: 0;
	}

	.benefit:last-child {
		padding-right: 0;
		border-right: 0;
	}

	.benefit__icon {
		display: grid;
		place-items: center;
		flex-shrink: 0;
		width: 44px;
		height: 44px;
		border-radius: 13px;
		background: var(--accent-soft);
		color: var(--secondary-deep);
	}

	.benefit__title {
		font-size: 0.92rem;
		line-height: 1.25;
		font-weight: 700;
		letter-spacing: -0.01em;
		color: var(--primary);
	}

	.benefit__description {
		margin-top: 4px;
		font-size: 0.79rem;
		line-height: 1.45;
		color: var(--muted);
	}

	@media (max-width: 980px) {
		.benefits__grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}

		.benefit {
			padding: 24px;
		}

		.benefit:nth-child(2) {
			border-right: 0;
			padding-right: 0;
		}

		.benefit:nth-child(3) {
			padding-left: 0;
			border-top: 1px solid var(--border);
		}

		.benefit:nth-child(4) {
			border-top: 1px solid var(--border);
		}
	}

	@media (max-width: 560px) {
		.benefit {
			gap: 10px;
			padding: 20px 12px;
		}

		.benefit:first-child,
		.benefit:nth-child(3) {
			padding-left: 0;
		}

		.benefit__icon {
			width: 38px;
			height: 38px;
			border-radius: 11px;
		}

		.benefit__title {
			font-size: 0.84rem;
		}

		.benefit__description {
			font-size: 0.74rem;
		}
	}
</style>
