const filled = new Set(['star', 'whatsapp', 'quote', 'facebook']);
const isFilled = filled.has(name);
const path = icons[name] ?? icons.snowflake;
---

<svg
	xmlns="http://www.w3.org/2000/svg"
	width={size}
	height={size}
	viewBox="0 0 24 24"
	fill={isFilled ? 'currentColor' : 'none'}
	stroke={isFilled ? 'none' : 'currentColor'}
	stroke-width={stroke}
	stroke-linecap="round"
	stroke-linejoin="round"
	class={className}
	aria-hidden="true"
	focusable="false"
	set:html={path}
/>
