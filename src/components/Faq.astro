---
import { defaultWhatsappUrl, faqs } from '../data/site';
import Icon from './ui/Icon.astro';
---

<section class="section faq" id="duvidas">
	<div class="container faq__inner">
		<div class="faq__head" data-reveal>
			<p class="eyebrow">Dúvidas frequentes</p>
			<h2 class="h2">Antes de instalar, a gente responde.</h2>
			<p class="faq__lead">
				Reunimos as perguntas que mais recebemos. Se a sua não estiver aqui, fale com a
				nossa equipe.
			</p>

			<div class="faq__support">
				<span class="faq__support-icon">
					<Icon name="headset" size={21} />
				</span>
				<div>
					<strong>Atendimento humano</strong>
					<span>Seg a sáb, das 8h às 18h</span>
				</div>
			</div>

			<a
				class="btn btn--primary faq__cta"
				href={defaultWhatsappUrl}
				target="_blank"
				rel="noopener noreferrer"
			>
				<Icon name="whatsapp" size={17} />
				Tirar dúvidas no WhatsApp
			</a>
		</div>

		<div class="faq__list" data-reveal data-reveal-delay="1">
			{faqs.map((faq, index) => (
				<details class="faq__item" open={index === 0}>
					<summary>
						<span>{faq.question}</span>
						<span class="faq__toggle" aria-hidden="true"></span>
					</summary>
					<div class="faq__answer">
						<p>{faq.answer}</p>
					</div>
				</details>
			))}
		</div>
	</div>
</section>

<style>
	.faq {
		background: var(--surface);
		border-top: 1px solid var(--border);
	}

	.faq__inner {
		display: grid;
		grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
		gap: clamp(36px, 6vw, 80px);
		align-items: start;
	}

	.faq__head {
		position: sticky;
		top: calc(var(--header-h) + 24px);
	}

	.faq__head .h2 {
		margin-top: 12px;
	}

	.faq__lead {
		margin-top: 14px;
		font-size: 0.95rem;
		line-height: 1.6;
		color: var(--muted);
	}

	.faq__support {
		display: flex;
		align-items: center;
		gap: 10px;
		margin-top: 24px;
	}

	.faq__support-icon {
		display: grid;
		place-items: center;
		width: 40px;
		height: 40px;
		border-radius: 12px;
		background: var(--accent-soft);
		color: var(--secondary-deep);
	}

	.faq__support div {
		display: flex;
		flex-direction: column;
		line-height: 1.3;
	}

	.faq__support strong {
		font-size: 0.84rem;
		color: var(--primary);
	}

	.faq__support span:last-child {
		font-size: 0.72rem;
		color: var(--muted);
	}

	.faq__cta {
		margin-top: 20px;
	}

	.faq__list {
		display: flex;
		flex-direction: column;
		gap: 10px;
	}

	.faq__item {
		border: 1px solid var(--border);
		border-radius: 15px;
		background: var(--bg);
		transition:
			border-color 180ms var(--ease),
			background-color 180ms var(--ease);
	}

	.faq__item[open] {
		border-color: var(--border-strong);
		background: var(--surface);
		box-shadow: var(--shadow-sm);
	}

	.faq__item summary {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 18px;
		min-height: 60px;
		padding: 14px 18px;
		font-size: 0.92rem;
		font-weight: 600;
		line-height: 1.4;
		color: var(--primary);
		list-style: none;
		cursor: pointer;
	}

	.faq__item summary::-webkit-details-marker {
		display: none;
	}

	.faq__toggle {
		position: relative;
		flex-shrink: 0;
		width: 22px;
		height: 22px;
		border-radius: 50%;
		background: var(--accent-soft);
	}

	.faq__toggle::before,
	.faq__toggle::after {
		content: '';
		position: absolute;
		top: 50%;
		left: 50%;
		width: 9px;
		height: 1.5px;
		border-radius: 2px;
		background: var(--primary);
		transform: translate(-50%, -50%);
		transition: transform 180ms var(--ease);
	}

	.faq__toggle::after {
		transform: translate(-50%, -50%) rotate(90deg);
	}

	.faq__item[open] .faq__toggle::after {
		transform: translate(-50%, -50%) rotate(0deg);
	}

	.faq__answer {
		padding: 0 18px 18px;
	}

	.faq__answer p {
		padding-top: 12px;
		border-top: 1px solid var(--border);
		font-size: 0.86rem;
		line-height: 1.6;
		color: var(--muted);
	}

	@media (max-width: 900px) {
		.faq__inner {
			grid-template-columns: 1fr;
		}

		.faq__head {
			position: static;
			max-width: 620px;
		}
	}

	@media (max-width: 520px) {
		.faq__cta {
			width: 100%;
		}

		.faq__item summary {
			padding: 14px;
			font-size: 0.88rem;
		}

		.faq__answer {
			padding: 0 14px 16px;
		}
	}
</style>
