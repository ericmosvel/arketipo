---
import { services } from '../data/site';
import Icon from './ui/Icon.astro';
---

<section class="section services" id="servicos">
	<div class="container">
		<div class="section-head" data-reveal>
			<div class="section-head__copy">
				<p class="eyebrow">Nossos serviços</p>
				<h2 class="h2">Tudo o que seu split precisa, em um só lugar.</h2>
			</div>
			<p class="services__intro">
				Da escolha do equipamento ao cuidado de longo prazo, uma equipe só acompanha
				todo o processo.
			</p>
		</div>

		<div class="services__grid">
			{services.map((service, index) => (
				<article
					class:list={['service-card', service.featured && 'service-card--featured']}
					data-reveal
					data-reveal-delay={String(index + 1)}
				>
					<div class="service-card__top">
						<span class="service-card__icon">
							<Icon name={service.icon} size={23} />
						</span>
						<span class="service-card__eyebrow">{service.eyebrow}</span>
						{service.featured && (
							<span class="service-card__tag">Mais procurado</span>
						)}
					</div>

					<h3 class="h3 service-card__title">{service.title}</h3>
					<p class="service-card__description">{service.description}</p>

					<ul class="service-card__features">
						{service.features.map((feature) => (
							<li>
								<span class="service-card__check">
									<Icon name="check" size={12} stroke={2.4} />
								</span>
								{feature}
							</li>
						))}
					</ul>

					<div class="service-card__footer">
						<div class="service-card__price">
							<strong>{service.price}</strong>
							<span>{service.priceNote}</span>
						</div>
						<a class="service-card__link" href={service.href}>
							{service.cta}
							<Icon
								name={service.href === '#equipamentos' ? 'arrow-right' : 'arrow-up-right'}
								size={17}
							/>
						</a>
					</div>
				</article>
			))}
		</div>
	</div>
</section>

<style>
	.services {
		position: relative;
		overflow: hidden;
	}

	.services::before {
		content: '';
		position: absolute;
		top: 8%;
		right: -180px;
		width: 480px;
		height: 480px;
		border-radius: 50%;
		background: radial-gradient(circle, rgba(220, 203, 255, 0.4), transparent 68%);
		pointer-events: none;
	}

	.services .container {
		position: relative;
		z-index: 1;
	}

	.services__intro {
		max-width: 300px;
		font-size: 0.9rem;
		line-height: 1.55;
		color: var(--muted);
	}

	.services__grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 20px;
	}

	.service-card {
		position: relative;
		display: flex;
		flex-direction: column;
		padding: 26px;
		background: var(--surface);
		border: 1px solid var(--border);
		border-radius: 20px;
		box-shadow: var(--shadow-sm);
		transition:
			transform 220ms var(--ease),
			box-shadow 220ms var(--ease),
			border-color 220ms var(--ease);
	}

	.service-card:hover {
		transform: translateY(-5px);
		border-color: var(--border-strong);
		box-shadow: var(--shadow-md);
	}

	.service-card--featured {
		background: linear-gradient(155deg, #21166f 0%, #36219b 58%, #4f2bd8 100%);
		border-color: transparent;
		box-shadow: 0 24px 48px rgba(33, 22, 111, 0.24);
		overflow: hidden;
	}

	.service-card--featured::before {
		content: '';
		position: absolute;
		top: -80px;
		right: -70px;
		width: 220px;
		height: 220px;
		border-radius: 50%;
		background: radial-gradient(circle, rgba(220, 203, 255, 0.23), transparent 68%);
		pointer-events: none;
	}

	.service-card__top {
		display: flex;
		align-items: center;
		gap: 10px;
		margin-bottom: 20px;
	}

	.service-card__icon {
		display: grid;
		place-items: center;
		width: 46px;
		height: 46px;
		border-radius: 13px;
		background: var(--accent-soft);
		color: var(--secondary-deep);
	}

	.service-card__eyebrow {
		font-size: 0.72rem;
		font-weight: 700;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: var(--muted);
	}

	.service-card__tag {
		margin-left: auto;
		padding: 5px 9px;
		border-radius: var(--radius-pill);
		background: var(--pink);
		color: var(--pink-ink);
		font-size: 0.64rem;
		font-weight: 700;
		letter-spacing: 0.02em;
		white-space: nowrap;
	}

	.service-card__title {
		position: relative;
		max-width: 270px;
		color: var(--primary);
	}

	.service-card__description {
		position: relative;
		margin-top: 10px;
		font-size: 0.89rem;
		line-height: 1.55;
		color: var(--muted);
	}

	.service-card__features {
		position: relative;
		display: flex;
		flex-direction: column;
		gap: 8px;
		margin-top: 20px;
		padding-top: 18px;
		border-top: 1px solid var(--border);
	}

	.service-card__features li {
		display: flex;
		align-items: flex-start;
		gap: 8px;
		font-size: 0.82rem;
		line-height: 1.4;
		color: var(--text);
	}

	.service-card__check {
		display: grid;
		place-items: center;
		flex-shrink: 0;
		width: 18px;
		height: 18px;
		margin-top: 1px;
		border-radius: 50%;
		background: #e9fbe1;
		color: var(--success-ink);
	}

	.service-card__footer {
		display: flex;
		align-items: flex-end;
		justify-content: space-between;
		gap: 14px;
		margin-top: auto;
		padding-top: 24px;
	}

	.service-card__price {
		display: flex;
		flex-direction: column;
		gap: 2px;
	}

	.service-card__price strong {
		font-size: 0.96rem;
		font-weight: 700;
		letter-spacing: -0.02em;
		color: var(--primary);
	}

	.service-card__price span {
		font-size: 0.68rem;
		line-height: 1.3;
		color: var(--muted);
	}

	.service-card__link {
		display: inline-flex;
		align-items: center;
		gap: 5px;
		flex-shrink: 0;
		min-height: 44px;
		font-size: 0.8rem;
		font-weight: 700;
		color: var(--primary);
		transition: color 160ms var(--ease), gap 160ms var(--ease);
	}

	.service-card__link:hover {
		gap: 8px;
		color: var(--secondary-deep);
	}

	.service-card--featured .service-card__icon {
		background: rgba(255, 255, 255, 0.12);
		color: #e2d6ff;
	}

	.service-card--featured .service-card__eyebrow,
	.service-card--featured .service-card__description,
	.service-card--featured .service-card__price span {
		color: rgba(255, 255, 255, 0.66);
	}

	.service-card--featured .service-card__title,
	.service-card--featured .service-card__features li,
	.service-card--featured .service-card__price strong {
		color: #fff;
	}

	.service-card--featured .service-card__features {
		border-top-color: rgba(255, 255, 255, 0.16);
	}

	.service-card--featured .service-card__check {
		background: rgba(189, 245, 168, 0.16);
		color: var(--success);
	}

	.service-card--featured .service-card__link {
		color: #fff;
	}

	.service-card--featured .service-card__link:hover {
		color: var(--accent);
	}

	@media (max-width: 1000px) {
		.services__grid {
			grid-template-columns: 1fr;
			max-width: 620px;
		}

		.services__intro {
			max-width: 460px;
		}
	}

	@media (max-width: 560px) {
		.service-card {
			padding: 22px;
			border-radius: 18px;
		}

		.service-card__footer {
			align-items: flex-start;
			flex-direction: column;
			gap: 8px;
		}
	}
</style>
